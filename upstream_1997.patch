+-- vers├úo (`max_steps`, `token_budget`, `history_message_window`, ÔÇª) vive em
+-- colunas tipadas nesta tabela, e o PATCH/INSERT da vers├úo as mapeia campo a
+-- campo. Nascer jsonb aqui seria divergir do vizinho sem CHECK forte nenhum.
+
+alter table public.ai_agent_versions
+  drop constraint if exists ai_agent_versions_inbound_debounce_ms_check;
+
+alter table public.ai_agent_versions
+  add column if not exists inbound_debounce_ms integer;
+
+comment on column public.ai_agent_versions.inbound_debounce_ms is
+  'Janela de coalesc├¬ncia de rajada inbound em ms para ESTE agente. NULL = usa o INBOUND_DEBOUNCE_MS da instala├º├úo; 0 = desliga a coalesc├¬ncia; teto 60s.';
